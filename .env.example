# ==============================================================================
# 1. Execution Mode ("demo" for Bybit Demo https://api-demo.bybit.com, "live" for Mainnet)
# ==============================================================================
BYBIT_MODE=demo

# ==============================================================================
# 2. Bybit v5 API Credentials
# ==============================================================================
# Used for "live" (Mainnet) or fallback when BYBIT_DEMO_API_KEY is empty
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Dedicated Bybit Demo Trading keys (used when BYBIT_MODE=demo)
BYBIT_DEMO_API_KEY=your_bybit_demo_api_key_here
BYBIT_DEMO_API_SECRET=your_bybit_demo_api_secret_here

# Optional read-only key for watchdog.py and ai_supervisor.py (positions, orders, wallet, executions).
# Create it with "Read-Only" permission for the same account/mode as above (demo key for BYBIT_MODE=demo).
# When empty, monitoring falls back to the trading keys.
BYBIT_READONLY_API_KEY=
BYBIT_READONLY_API_SECRET=

# ==============================================================================
# 3. Telegram Bot Credentials (for Watchdog 24/7 Alerts & AI Supervisor Chat)
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Where alerts and briefings go. Comma-separated list is allowed; a private chat id equals the user id.
# Must be set explicitly: the supervisor ignores all commands while this and TELEGRAM_ALLOWED_USER_IDS are empty.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Numeric Telegram user ids of admins allowed to send commands and press buttons (comma-separated).
# Commands are accepted in a private chat with the bot or in TELEGRAM_CHAT_ID chats.
# If TELEGRAM_CHAT_ID is empty, notifications go to these ids.
# Example ids below are fake: uncomment and put your own, otherwise strangers with these ids get access.
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ==============================================================================
# 4. AI Supervisor Credentials & Monthly Budget Cap
# ==============================================================================
# Option A: Native Anthropic Claude API (e.g. claude-opus-5-5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5-5
AI_MONTHLY_LIMIT_USD=50.0

# Option B: Native Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option C: Universal OpenAI / OpenRouter / Custom Proxy
AI_API_KEY=your_monthly_super_token_or_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
